# Copie para .env e preencha antes de rodar o servidor (npm run server).
# Nunca commitar o .env real.

AUDIT_PORT=3456

# Login de admin do audit-engine (POST /api/auth/login).
# Sem estas duas variaveis, o login falha fechado (nenhum fallback hardcoded).
ADMIN_EMAIL=
# Hash bcrypt da senha — gerar com: AuthService.hashPassword('sua-senha') (src/auth/jwt.ts)
ADMIN_PASSWORD_HASH=

# Segredos de assinatura dos tokens JWT — obrigatorio definir em producao
JWT_SECRET=
JWT_REFRESH_SECRET=
