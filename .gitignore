# =====================================================================
# POLÍTICA: NEGAR POR PADRÃO (LGPD)
#
# Nada é versionado a menos que liberado explicitamente na seção 3.
#
# Motivo: enumerar o que excluir falhou cinco vezes seguidas. SmartBrain,
# audits/*/audit.json, reports/*/data.js, fixtures de teste e capturas do
# .playwright-mcp entraram no git porque cada saída nova do pipeline
# nascia FORA da lista de exclusão. Enumerar exige lembrar; negar por
# padrão não exige nada. Um artefato novo só entra se alguém decidir
# liberá-lo aqui, de propósito.
#
# Lembrete: .gitignore NÃO solta arquivo já rastreado. Para tirar algo do
# git sem apagar do disco: git rm --cached <arquivo>
# =====================================================================

# --- 1) Negar tudo ---------------------------------------------------
*

# --- 2) Permitir que o git desça nos diretórios -----------------------
# Sem isto, o git para no primeiro nível e nada da seção 3 é alcançado.
!*/

# --- 3) Liberar código-fonte e documentação ---------------------------
!*.jsx
!*.js
!*.mjs
!*.ts
!*.py
!*.ps1
!*.md
!*.css
!*.html
!*.json
!*.toml
!*.yml
!*.yaml
!.gitignore
!.gitattributes

# Templates com dado sintético (verificados: sem dado real)
!/docs/templates/*.csv
!/betting_ev_engine/data/*.csv

# Cartão de prévia dos links comerciais. É arte gerada por script
# (scripts/gera-card-social.py), sem captura de tela e sem dado de cliente.
# Precisa ser versionado porque o build da publicação aborta se ele faltar,
# e um clone sem o arquivo não conseguiria publicar.
!/docs/go-to-market/atlas-card.png

# =====================================================================
# 4) RE-NEGAÇÃO — vem DEPOIS de propósito: sobrepõe a seção 3.
#    Diretório negado não é percorrido, então nada dentro dele volta.
# =====================================================================

# --- 4a) Dependências e build ----------------------------------------
# Obrigatório: a seção 3 liberaria todo .js/.json dentro de node_modules.
node_modules/
dist/
dist-app/
build/
.cache/
__pycache__/
*.pyc

# --- 4b) LGPD: dado real de cliente ----------------------------------
# Pastas de dado operacional real (PDFs, relatórios, dados de clientes)
/audits/
/reports/
/SmartBrain/
# Pastas de instancia / dado operacional. Nome de cliente nao mora no produto:
# qualquer arvore com esse padrao (ou legada com nome de casa) fica fora do git.
# O codigo do app vive na raiz deste repositorio e no submodule de instancia.
Verificação Mensal de Carteiras*/
Verificação de carteiras/
Verificação Mensal de Carteiras Mirabaud/

# Capturas e dumps de página: renderizam o dashboard com dado real.
# Os .png não são pesquisáveis por grep — varredura textual não os pega.
/.playwright-mcp/

# Gabaritos de teste congelados a partir de audit.json real
/audit-engine/tests/fixtures/

# (bloco movido para o FIM do arquivo: a re-inclusao so vence as negacoes
#  globais de binario se vier depois delas)

# Gabarito de parity sem dado identificavel: so totais e plRef, nomes hasheados.
# Precisa ser versionado, senao o parity nunca roda em clone limpo, que e
# exatamente a falha que deixou as duas suites pulando em silencio.
#
# Ordem obrigatoria: re-inclui o diretorio para o git descer, re-nega TUDO
# dentro dele (senao o `!*.json` global la em cima re-exporia o gabarito real
# com nome de cliente), e libera SO o .anon.json. Nao simplificar para um unico
# `!...*.anon.json`: sem a re-negacao, o dado real vaza.
!/audit-engine/tests/fixtures/
/audit-engine/tests/fixtures/*
!/audit-engine/tests/fixtures/*.anon.json

# Marca da instancia. Nao e LGPD, mas e especifico de quem opera o deploy:
# o produto nasce neutro e cada instancia assina as telas com o proprio
# platform-brand.js. Versionar um aqui faria a marca de um cliente viajar
# junto com o produto, que e exatamente o que se quer evitar.
platform-brand.js

# Dado real embutido em JS (alimenta o app; migra para R2 no Projeto 3)
platform-data-real.js
platform-data-audit.js
platform-historico.js
platform-oportunidades.js
platform-vencimentos.js
platform-caixa-parado.js
platform-radar.js
platform-credito.js
platform-receita-drop.js
data.js
data.json
historico.js
historico.json

# --- 4c) Binários que carregam dado real ------------------------------
*.pdf
*.docx
*.xlsx
*.xls
*.zip

# --- 4d) Efêmero e ambiente ------------------------------------------
.env
.env.local
.env.*.local
*.log

# Configuração local do Claude Code (por máquina, não compartilhar)
.claude/settings.local.json
terminals/
docs/terminal*/
.archive/

# Dumps de ferramentas de agente (scraping, fetch — resíduo, não é produto)
agent-tools/

# Mockups de sessão do companheiro visual de brainstorming (skill superpowers)
.superpowers/

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Temporários
*.tmp
*.bak
*.swp
*~

# Editores
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Diretorios de publicacao gerados por scripts/build-deploy.mjs
/dist-deploy/
/demo-worker/public/

# Artefatos do seed do demo do snapshot (sinteticos, regeneraveis)
/snapshot-demo-data/
AI_OPERATING_SYSTEM/
graphify-out/

# --- 4e) Obsidian vault — config versionada, estado de UI nao ----------------
# Os .json do .obsidian sao liberados pela regra !*.json na secao 3, mas
# workspace.json e workspace-mobile.json tem churn constante de UI e nao
# carregam config que faca sentido compartilhar entre maquinas.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Conteudo pessoal do vault — notas e anexos nao versionados.
/daily/
/templates/
/assets/

# Fixtures SINTETICOS do snapshot (Fase 1): dado ficticio, versionavel de
# proposito — e a fonte do seed do demo. Este bloco fica no FIM de proposito:
# a re-inclusao precisa vir DEPOIS das negacoes globais de binario (4c) para
# vencer. Re-inclui a pasta e os subdiretorios (sem o !**/ o git nao desce),
# re-nega tudo dentro e libera so os formatos gerados.
!/audit-engine/tests/fixtures-sinteticos/
/audit-engine/tests/fixtures-sinteticos/*
!/audit-engine/tests/fixtures-sinteticos/**/
!/audit-engine/tests/fixtures-sinteticos/**/*.xlsx
!/audit-engine/tests/fixtures-sinteticos/**/*.csv
!/audit-engine/tests/fixtures-sinteticos/**/*.html
!/audit-engine/tests/fixtures-sinteticos/**/*.json
!/audit-engine/tests/fixtures-sinteticos/**/*.pdf
!/audit-engine/tests/fixtures-sinteticos/**/*.txt
