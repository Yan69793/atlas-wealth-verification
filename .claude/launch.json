{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "atlas-vite-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5178", "--strictPort"],
      "port": 5178
    },
    {
      "name": "atlas-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "5179", "--strictPort"],
      "port": 5179
    },
    {
      "name": "atlas-spa",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "7821", "--directory", "${workspaceFolder}"],
      "port": 7821
    },
    {
      "name": "atlas-demo-pacote",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "7822", "--directory", "${workspaceFolder}/dist-deploy"],
      "port": 7822
    },
    {
      "name": "atlas-demo-worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "--config", "${workspaceFolder}/demo-worker/wrangler.toml", "--port", "8788", "--ip", "127.0.0.1", "--compatibility-date", "2026-07-28"],
      "port": 8788
    },
    {
      "name": "atlas-portal",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "--config", "${workspaceFolder}/../ATLAS-PORTAL/wrangler.toml", "--port", "8787", "--ip", "127.0.0.1", "--persist-to", "${workspaceFolder}/../ATLAS-PORTAL/.wrangler/state"],
      "port": 8787
    },
    {
      "name": "atlas-go-to-market",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "7823", "--directory", "${workspaceFolder}/docs/go-to-market"],
      "port": 7823
    },
    {
      "name": "audit-engine-server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=${workspaceFolder}/audit-engine/.env", "${workspaceFolder}/audit-engine/dist/src/server.js"],
      "port": 3456
    }
  ]
}
